# Claude (general-purpose baseline), Messages API — this is Anthropic's own
# documented variable name, not one invented for this project. Model
# identifier: claude-sonnet-5 (an alias; no dated/pinned version is exposed
# by the Messages API — see benchmark/reports/phase5-claude-research.md).
ANTHROPIC_API_KEY=

# Jev (specialized decision model), via Vercel AI Gateway /v1/evaluate — this
# is Vercel's own documented variable name (vercel.com/docs/ai-gateway/sdks-and-apis/typesafe),
# not one invented for this project. Model identifier: typesafe-ai/jev (no
# pinned version is exposed through this Gateway path — see
# benchmark/reports/phase4-jev-research.md).
AI_GATEWAY_API_KEY=

# Default hybrid escalation threshold (0-1). Configurable, not claimed optimal —
# see the threshold analysis in reports/benchmark-summary.md once it exists.
HYBRID_CONFIDENCE_THRESHOLD=0.80
